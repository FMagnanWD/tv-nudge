<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Le Fire TV parle en HTTP simple, sur le réseau de la maison. -->
    <application
            android:label="@string/app_name"
            android:icon="@drawable/icone"
            android:usesCleartextTraffic="true"
            android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".Envoi" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".Historique" android:exported="false"/>
    </application>
</manifest>
